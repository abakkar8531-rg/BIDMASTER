
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | BIDMASTER</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #eef2f7;
            padding: 30px;
        }

        .container {
            max-width: 1100px;
            margin: auto;
        }

        h1 {
            color: #172554;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #64748b;
            margin-bottom: 25px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .stat-card h3 {
            color: #64748b;
            margin-bottom: 12px;
        }

        .stat-card p {
            color: #172554;
            font-size: 30px;
            font-weight: bold;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            padding: 12px 18px;
            background: #2563eb;
            color: white;
            text-decoration: none;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }

        .btn:hover {
            background: #1d4ed8;
        }

        .logout {
            background: #dc2626;
        }

        .logout:hover {
            background: #b91c1c;
        }

        .delete-btn {
            background: #dc2626;
            color: white;
            padding: 8px 12px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .delete-btn:hover {
            background: #b91c1c;
        }

        .table-card {
            background: white;
            padding: 20px;
            border-radius: 10px;
            overflow-x: auto;
        }

        .table-card h2 {
            color: #172554;
            margin-bottom: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 13px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }

        th {
            background: #172554;
            color: white;
        }

        tr:hover {
            background: #f8fafc;
        }

        @media (max-width: 700px) {
            body {
                padding: 15px;
            }

            .stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <div class="container">

        <h1>🛠️ BIDMASTER Admin Dashboard</h1>
        <p class="subtitle">Manage users, auctions and bidding activities.</p>

        <div class="stats">

            <div class="stat-card">
                <h3>Total Registered Users</h3>
                <p><%= totalUsers %></p>
            </div>

            <div class="stat-card">
                <h3>Total Auctions</h3>
                <p><%= totalAuctions %></p>
            </div>

            <div class="stat-card">
                <h3>Total Bids</h3>
                <p><%= totalBids %></p>
            </div>

        </div>

        <div class="actions">

            <a href="/admin/add-auction" class="btn">
                ➕ Add New Auction
            </a>

            <a href="/admin/users" class="btn">
                👥 View Registered Users
            </a>

            <a href="/admin/bids" class="btn">
                📊 View All Bids
            </a>

            <a href="/admin/winners" class="btn">
                🏆 View Auction Winners
            </a>

            <a href="/auctions" class="btn">
                🌐 View Auction Website
            </a>

            <form action="/admin-logout" method="POST">
                <button type="submit" class="btn logout">
                    Logout
                </button>
            </form>

        </div>

        <div class="table-card">

            <h2>Manage Auctions</h2>

            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Product Name</th>
                        <th>Starting Price</th>
                        <th>Current Bid</th>
                        <th>End Time</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    <% auctions.forEach(function(auction) { %>
                        <tr>
                            <td><%= auction.id %></td>

                            <td><%= auction.title %></td>

                            <td>₹<%= auction.starting_price %></td>

                            <td>₹<%= auction.current_bid %></td>

                            <td><%= auction.end_time %></td>

                            <td>
                                <form
                                    action="/admin/delete-auction/<%= auction.id %>"
                                    method="POST"
                                    onsubmit="return confirm('Are you sure you want to delete this auction and its bid history?');">

                                    <button type="submit" class="delete-btn">
                                        Delete
                                    </button>

                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>

        </div>

    </div>
</body>
</html>
