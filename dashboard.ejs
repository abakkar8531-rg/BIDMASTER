
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Dashboard | BIDMASTER</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #101010;
            color: white;
        }

        nav {
            background: #1b1b1b;
            padding: 22px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #444;
        }

        .logo {
            color: #d4af37;
            font-size: 27px;
            font-weight: bold;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
        }

        nav a:hover {
            color: #d4af37;
        }

        .container {
            max-width: 1100px;
            margin: 60px auto;
            padding: 20px;
        }

        .welcome {
            margin-bottom: 35px;
        }

        .welcome h1 {
            font-size: 36px;
            margin-bottom: 12px;
        }

        .welcome span {
            color: #d4af37;
        }

        .welcome p {
            color: #aaa;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 25px;
        }

        .card {
            background: #1d1d1d;
            border: 1px solid #444;
            border-radius: 13px;
            padding: 30px;
            transition: 0.3s;
        }

        .card:hover {
            border-color: #d4af37;
            transform: translateY(-5px);
        }

        .card h2 {
            color: #d4af37;
            margin-bottom: 15px;
        }

        .card p {
            color: #bbb;
            line-height: 1.6;
            margin-bottom: 22px;
        }

        .btn {
            display: inline-block;
            padding: 12px 20px;
            background: #d4af37;
            color: #111;
            text-decoration: none;
            border-radius: 7px;
            font-weight: bold;
        }

        .btn:hover {
            background: #f0cc55;
        }

        .account {
            margin-top: 35px;
            background: #1d1d1d;
            padding: 25px;
            border-radius: 12px;
            border: 1px solid #444;
        }

        .account h2 {
            color: #d4af37;
            margin-bottom: 18px;
        }

        .account p {
            color: #ccc;
            margin: 12px 0;
        }

        footer {
            text-align: center;
            color: #888;
            padding: 30px;
            margin-top: 50px;
        }

        @media(max-width: 600px) {
            nav {
                flex-direction: column;
                gap: 15px;
            }

            nav a {
                margin: 5px;
            }

            .welcome h1 {
                font-size: 28px;
            }
        }
    </style>
</head>

<body>

<nav>
    <div class="logo">BIDMASTER</div>

    <div>
        <a href="/">Home</a>
        <a href="/auctions">Auctions</a>
        <a href="/my-bids">My Bids</a>
        <a href="/logout">Logout</a>
    </div>
</nav>

<div class="container">

    <div class="welcome">
        <h1>Welcome, <span><%= user.name %>!</span></h1>
        <p>Welcome to your BIDMASTER account dashboard.</p>
    </div>

    <div class="cards">

        <div class="card">
            <h2>Explore Auctions</h2>
            <p>Discover exciting products and find items you want to purchase.</p>
            <a href="/auctions" class="btn">View Auctions</a>
        </div>

        <div class="card">
            <h2>My Bids</h2>
            <p>Check your bidding history and view the bids you have placed.</p>
            <a href="/my-bids" class="btn">View My Bids</a>
        </div>

        <div class="card">
            <h2>Start Bidding</h2>
            <p>Find your favourite product and compete with other bidders.</p>
            <a href="/auctions" class="btn">Bid Now</a>
        </div>

    </div>

    <div class="account">
        <h2>My Account</h2>

        <p><strong>Name:</strong> <%= user.name %></p>

        <p><strong>Email:</strong> <%= user.email %></p>

        <p><strong>Account Status:</strong> Active</p>
    </div>

</div>

<footer>
    © 2026 BIDMASTER. All Rights Reserved.
</footer>

</body>
</html>
